# Optional. Prefer CLI flags: mlx-serve --model org/name --port 8888
# Precedence: CLI flag > environment variable > .env > default
HOST=127.0.0.1
PORT=8888
# Startup model (models can also be switched at runtime from Claude Code's /model picker)
MODEL_NAME=mlx-community/GLM-4.5-Air-3bit
# Set false to start without loading a model
PRELOAD=true
# API-exposed model name
API_MODEL_NAME=claude-4-sonnet-20250514
